# Пример reverse-proxy — актуальные шаблоны:
#   deploy/nginx/resume.conf.template
#   deploy/nginx/resume-ssl.conf.template
# Установка SSL:
#   DOMAIN=alexnazarov.site LETSENCRYPT_EMAIL=sysadm1989@gmail.com ./scripts/setup-ssl.sh
#
# Ниже — минимальный HTTP-прокси на Docker-приложение (127.0.0.1:8787).

server {
  listen 80;
  server_name alexnazarov.site;

  client_max_body_size 10m;

  location / {
    proxy_pass http://127.0.0.1:8787;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 300s;
  }
}
