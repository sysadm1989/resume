# Server (Docker слушает 8787 только на localhost)
PORT=8787
HOST=0.0.0.0

# Hugging Face Inference (OpenAI-compatible router)
# Токен: https://huggingface.co/settings/tokens (permission: Make calls to Inference Providers)
HF_TOKEN=hf_xxxxxxxx
HF_API_BASE=https://router.huggingface.co/v1
# Бесплатный/дешёвый чат; при необходимости смените модель
HF_MODEL=Qwen/Qwen2.5-7B-Instruct:cheapest
LLM_TIMEOUT_MS=120000
MAX_VACANCY_CHARS=80000

# TLS (nginx + certbot на хосте). Для scripts/setup-ssl.sh
DOMAIN=resume.example.com
LETSENCRYPT_EMAIL=you@example.com
