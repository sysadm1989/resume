# Server (app внутри Docker слушает 8787 только на localhost)
PORT=8787
HOST=0.0.0.0

# OpenCode
OPENCODE_BIN=opencode
OPENCODE_MODEL=opencode/deepseek-v4-flash-free
OPENCODE_TIMEOUT_MS=180000
MAX_VACANCY_CHARS=80000

# Docker: абсолютный путь к конфигу OpenCode на хосте (после `opencode auth`)
OPENCODE_CONFIG_DIR=/home/ubuntu/.config/opencode

# TLS (nginx + certbot на хосте). Для scripts/setup-ssl.sh
DOMAIN=resume.example.com
LETSENCRYPT_EMAIL=you@example.com
